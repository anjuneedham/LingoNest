{
  "name": "@lingonest/core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript domain logic: CEFR, activities, evaluation, SRS, progress, pricing, booking. No platform dependencies.",
  "type": "module",
  "main": "./src/index.ts",
