# ---------------------------------------------------------------------------
# LingoNest — environment variables
# Copy to .env (never commit .env). See docs/SETUP.md for provisioning steps.
# ---------------------------------------------------------------------------

# --- Client-safe (bundled into the mobile app) -----------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SENTRY_DSN=
# Publishable key only. The secret key must never reach the client.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_VIDEO_PROVIDER=daily

# --- Server-side only (Supabase Edge Function secrets) ---------------------
# Set with: supabase secrets set KEY=value
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_CLIENT_ID=ca_xxx

# Video provider for live tutoring (abstracted; swap provider freely)
VIDEO_PROVIDER=daily
DAILY_API_KEY=

# Text-to-speech provider for lesson audio generation (build-time tooling)
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Analytics sink
ANALYTICS_WRITE_KEY=
